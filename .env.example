# Database Connection (Local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/E-office?schema=public"

# App Secret for session/token
JWT_SECRET="your-jwt-secret-key"

# Supabase Credentials (Optional Cloud Auth)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Email SMTP Settings (Real Gmail / SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-16-digit-app-password"
SMTP_FROM="FLAS E-Office <your-email@gmail.com>"
